{% extends 'base.html.twig' %}
{% block title %}Catalog · Symfony Shop{% endblock %}
{% block body %}
<h1>Catalog</h1>
<div class="grid">
    {% for product in products %}
        <div class="card">
            <a class="product-link" data-product-id="{{ product.id }}" href="{{ path('app_product', {id: product.id}) }}">{{ product.name }}</a>
            <p class="price">{{ product.formattedPrice }}</p>
        </div>
    {% endfor %}
</div>
<p class="muted pagination">
    {% if page > 1 %}<a href="{{ path('app_products', {page: page - 1}) }}">&larr; Previous</a>{% endif %}
    Page {{ page }} of {{ total_pages }}
    {% if page < total_pages %}<a href="{{ path('app_products', {page: page + 1}) }}">Next &rarr;</a>{% endif %}
</p>
{% endblock %}
