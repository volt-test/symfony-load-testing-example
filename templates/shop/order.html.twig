{% extends 'base.html.twig' %}
{% block title %}Order {{ order.reference }} · Symfony Shop{% endblock %}
{% block body %}
<div class="card">
    <h1>Thank you!</h1>
    <p>Order <strong class="order-reference">{{ order.reference }}</strong> is <span class="order-status">{{ order.status }}</span>.</p>
    <table>
        <thead><tr><th>Product</th><th>Qty</th><th>Unit</th><th>Subtotal</th></tr></thead>
        <tbody>
        {% for item in order.items %}
            <tr><td>{{ item.product.name }}</td><td>{{ item.quantity }}</td><td>${{ (item.unitPrice / 100)|number_format(2) }}</td><td>${{ (item.subtotal / 100)|number_format(2) }}</td></tr>
        {% endfor %}
        </tbody>
        <tfoot><tr><th colspan="3">Total</th><th class="order-total">{{ order.formattedTotal }}</th></tr></tfoot>
    </table>
</div>
{% endblock %}
