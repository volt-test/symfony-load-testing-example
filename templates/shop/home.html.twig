{% extends 'base.html.twig' %}
{% block body %}
<h1>Featured products</h1>
<div class="grid">
    {% for product in products %}
        <div class="card">
            <a class="product-link" data-product-id="{{ product.id }}" href="{{ path('app_product', {id: product.id}) }}">{{ product.name }}</a>
            <p class="muted">{{ product.category }}</p>
            <p class="price">{{ product.formattedPrice }}</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
